{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HexEdit",
  "version": "0.1.0",
  "identifier": "dev.hexedit.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HexEdit",
        "width": 1440,
        "height": 880,
        "minWidth": 900,
        "minHeight": 500,
        "dragDropEnabled": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
