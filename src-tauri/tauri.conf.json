{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HexEdit",
  "identifier": "dev.hexedit.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HexEdit",
        "width": 1440,
        "height": 880,
        "minWidth": 900,
        "minHeight": 500,
        "dragDropEnabled": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "HexEdit",
    "category": "DeveloperTool",
    "shortDescription": "Hex editor with data inspector and C-struct templates",
    "longDescription": "A hex editor with a data inspector for common data types and C-struct templates that decode file formats into a tree.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
